---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteOrigin } from '../lib/site';

const site = getSiteOrigin();
const siteName = import.meta.env.PUBLIC_SITE_NAME ?? 'AMPHON TRADING';
const addressLocality = 'อำเภอเมืองอุบลราชธานี';
const addressRegion = 'อุบลราชธานี';
const postalCode = '34000';
const mapEmbedSrc = 'https://www.google.com/maps?q=15.2664215,104.844358&z=16&output=embed';
const mapUrl = 'https://maps.app.goo.gl/krv97o14jPTRrnpW8';
const businessPhone = import.meta.env.PUBLIC_BUSINESS_PHONE ?? '+66-64-257-9353';
const openingHours = 'หน้าร้าน 09:00–19:00 น.';
const geoLat = 15.2664215;
const geoLng = 104.844358;
const serviceAreasRaw =
	import.meta.env.PUBLIC_SERVICE_AREAS ??
	'กรุงเทพมหานคร,ปริมณฑล,อุบลราชธานี,ขอนแก่น,นครราชสีมา,อุดรธานี';
const serviceAreas = serviceAreasRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);

const contactJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'ContactPage',
		name: `ติดต่อเรา | ${siteName}`,
		url: `${site}/contact/`,
		mainEntity: {
			'@type': 'LocalBusiness',
			name: 'บริษัท อำพล เทรดดิ้ง จำกัด',
			telephone: businessPhone,
			areaServed: serviceAreas.map((area) => ({
				'@type': 'AdministrativeArea',
				name: area,
			})),
			hasMap: mapUrl,
			geo: {
				'@type': 'GeoCoordinates',
				latitude: geoLat,
				longitude: geoLng,
			},
			openingHoursSpecification: [
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
					opens: '09:00',
					closes: '19:00',
				},
			],
			address: {
				'@type': 'PostalAddress',
				streetAddress: '740/8 ถนนชยางกูร ตำบลในเมือง',
				addressLocality,
				addressRegion,
				postalCode,
				addressCountry: 'TH',
			},
			contactPoint: {
				'@type': 'ContactPoint',
				contactType: 'customer support',
				availableLanguage: ['Thai'],
				url: 'https://line.me/R/ti/p/@webuy',
				telephone: businessPhone,
			},
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: site },
			{ '@type': 'ListItem', position: 2, name: 'ติดต่อเรา', item: `${site}/contact/` },
		],
	},
];
---

<BaseLayout
	title="ติดต่อเรา | AMPHON TRADING"
	description="ติดต่อทีมงาน AMPHON TRADING (อำพล เทรดดิ้ง) ผ่าน LINE @webuy พร้อมเวลาทำการและแผนที่"
	pathname="/contact/"
	jsonLd={contactJsonLd}
>
	<section class="container contact">
		<nav aria-label="breadcrumb" class="breadcrumb">
			<a href="/">หน้าแรก</a> &gt; <span>ติดต่อเรา</span>
		</nav>
		<div class="contact-head">
			<p class="eyebrow">ติดต่อทีมงาน</p>
			<h1>ช่องทางติดต่อหลักของ AMPHON TRADING (อำพล เทรดดิ้ง)</h1>
			<p>
				ต้องการประเมินราคาสินค้าหรือสอบถามบริการ ติดต่อเราผ่าน LINE ได้ทันที
				รับข้อความเสนอขายผ่าน LINE @webuy ได้ตลอด 24 ชั่วโมง เจ้าหน้าที่ตอบตามคิวงาน
			</p>
		</div>

		<div class="contact-grid">
			<article class="card">
				<h2>ติดต่อด่วน</h2>
				<p class="line-box">
					Line:
					<a href="https://line.me/R/ti/p/@webuy" target="_blank" rel="noopener noreferrer">@webuy</a>
				</p>
				<p>โทรศัพท์: <a href={`tel:${businessPhone.replace(/\s+/g, '')}`}>{businessPhone}</a></p>
				<p>เวลาเปิดหน้าร้าน: {openingHours}</p>
				<p>จุดสังเกต: ติดปากซอยชยางกูร 32</p>
				<p>LINE @webuy: ติดต่อขายได้ตลอด 24 ชั่วโมง เจ้าหน้าที่ตอบตามคิวงาน</p>
				<a class="btn" href="https://line.me/R/ti/p/@webuy" target="_blank" rel="noopener noreferrer">
					แชท LINE ตอนนี้
				</a>
			</article>

			<article class="card">
				<h2>พื้นที่ให้บริการ</h2>
				<ul>
					{serviceAreas.map((area) => (
						<li>{area}</li>
					))}
				</ul>
			</article>
		</div>

		<section class="map-wrap" aria-label="แผนที่">
			<h2>แผนที่</h2>
		<iframe
			title="แผนที่ตำแหน่งบริการ"
			src={mapEmbedSrc}
			width="960"
			height="400"
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
		></iframe>
		</section>
	</section>
</BaseLayout>

<style>
	.contact {
		padding-top: 2rem;
	}
	.contact-head h1 {
		margin: 0.2rem 0 0.65rem;
		font-size: clamp(1.5rem, 3.4vw, 2.1rem);
	}
	.contact-head p {
		margin: 0;
		max-width: 62ch;
		color: var(--muted);
	}
	.eyebrow {
		margin: 0;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--accent);
		font-weight: 700;
	}
	.contact-grid {
		margin-top: 1.25rem;
		display: grid;
		gap: 1rem;
	}
	@media (min-width: 820px) {
		.contact-grid {
			grid-template-columns: 1.3fr 1fr;
		}
	}
	.card {
		background: var(--surface);
		border: 1px solid rgba(36, 48, 67, 0.12);
		border-radius: var(--radius);
		padding: 1rem 1.05rem;
		box-shadow: 0 6px 16px rgba(18, 31, 43, 0.05);
	}
	.card h2 {
		margin: 0 0 0.6rem;
		font-size: 1.1rem;
	}
	.card p {
		margin: 0.4rem 0;
	}
	.line-box {
		font-size: 1.08rem;
		font-weight: 700;
	}
	.btn {
		display: inline-block;
		margin-top: 0.7rem;
		padding: 0.55rem 0.9rem;
		background: #06c755;
		color: #fff;
		border-radius: 8px;
		font-weight: 700;
		text-decoration: none;
	}
	.btn:hover {
		background: #04b84d;
		text-decoration: none;
	}
	.card ul {
		margin: 0;
		padding-left: 1rem;
		display: grid;
		gap: 0.25rem;
	}
	.map-wrap {
		margin-top: 1.2rem;
	}
	.map-wrap h2 {
		margin: 0 0 0.55rem;
		font-size: 1.2rem;
	}
	.map-wrap iframe {
		width: 100%;
		min-height: 340px;
		border: 1px solid rgba(36, 48, 67, 0.12);
		border-radius: var(--radius);
		background: #f3f3f3;
	}
</style>
