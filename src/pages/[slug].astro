---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { LocalPost } from '../lib/posts';
import { getAllPosts, getFeaturedImageAttrs, getFeaturedImageUrl, getPostIndexPolicy, getPostTags, getRoutablePosts } from '../lib/posts';
import { sanitizePostContentHtml } from '../lib/post-content-hygiene.mjs';
import { buildPostStructuredData, classifyPostPageIntent, isEditorialIntent } from '../lib/post-page-intent.mjs';
import { getPostSeoOverride, preparePostContent } from '../lib/post-seo-overrides';
import { getSiteOrigin } from '../lib/site';

export async function getStaticPaths() {
	return getRoutablePosts().map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

interface Props {
	post: LocalPost;
}

const { post } = Astro.props;
const featuredAttrs = getFeaturedImageAttrs(post);
const featuredUrl = getFeaturedImageUrl(post);
const tags = getPostTags(post);
const indexPolicy = getPostIndexPolicy(post);
const pageIntent = classifyPostPageIntent(post);
const isEditorial = isEditorialIntent(pageIntent);
const plainTitle = post.title.rendered.replace(/<[^>]+>/g, '').trim();
const plainExcerpt = post.excerpt.rendered.replace(/<[^>]+>/g, '').trim();
const seoOverride = getPostSeoOverride(post.slug);
const pageTitle = seoOverride?.title ?? plainTitle;
const pageDescription =
	seoOverride?.description ?? (plainExcerpt || `${isEditorial ? 'อ่านบทความ' : 'ดูรายละเอียดบริการ'} ${plainTitle} จาก AMPHON TRADING`);
const pageContent = sanitizePostContentHtml(preparePostContent(post.slug, post.content.rendered));
const site = getSiteOrigin();
const pagePath = `/${post.slug}/`;
const pageUrl = `${site}${pagePath}`;

// Related links stay inside the same broad page intent so service pages do not
// point to arbitrary editorial posts and vice versa.
const allPosts = getAllPosts();
const relatedPosts = allPosts
	.filter((candidate) => {
		if (candidate.slug === post.slug) return false;
		if (getPostIndexPolicy(candidate).lifecycle !== 'INDEX') return false;
		return isEditorialIntent(classifyPostPageIntent(candidate)) === isEditorial;
	})
	.sort((a, b) => {
		if (!isEditorial) {
			const aIntent = classifyPostPageIntent(a);
			const bIntent = classifyPostPageIntent(b);
			const aSameFamily = aIntent.familyKey === pageIntent.familyKey ? 1 : 0;
			const bSameFamily = bIntent.familyKey === pageIntent.familyKey ? 1 : 0;
			if (aSameFamily !== bSameFamily) return bSameFamily - aSameFamily;
		}
		return new Date(b.modified ?? b.date).getTime() - new Date(a.modified ?? a.date).getTime();
	})
	.slice(0, 3);

const pageJsonLd = buildPostStructuredData({
	post,
	intent: pageIntent,
	title: pageTitle,
	description: pageDescription,
	url: pageUrl,
	site,
	featuredUrl,
	tags,
});
---

<BaseLayout
	title={`${pageTitle} | AMPHON TRADING`}
	description={pageDescription}
	pathname={pagePath}
	type={isEditorial ? 'article' : 'website'}
	ogImage={featuredUrl}
	publishedTime={isEditorial ? post.date : undefined}
	modifiedTime={isEditorial ? (post.modified ?? post.date) : undefined}
	jsonLd={pageJsonLd}
	noindex={indexPolicy.lifecycle !== 'INDEX'}
>
	<main class="container article">
		<nav aria-label="breadcrumb" class="breadcrumb">
			<a href="/">หน้าแรก</a> &gt;
			{isEditorial ? <a href="/blog/">บทความ</a> : <span>{pageIntent.kind === 'LOCAL_SERVICE' ? 'พื้นที่ให้บริการ' : 'บริการ'}</span>} &gt;
			<span set:html={post.title.rendered} />
		</nav>
		<header class="article-head">
			{
				isEditorial && (
					<time class="date" datetime={post.date}>
						{new Date(post.date).toLocaleDateString('th-TH', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})}
					</time>
				)
			}
			<h1 class="title" set:html={post.title.rendered} />
		</header>

		{
			featuredAttrs && (
				<img
					class="hero-img"
					src={featuredAttrs.src}
					alt={featuredAttrs.alt}
					width={featuredAttrs.width}
					height={featuredAttrs.height}
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
			)
		}

		<div class="prose content" set:html={pageContent} />

		<aside class="post-cta" aria-label="ติดต่อประเมินราคา">
			<p class="post-cta-text">อยากขายสินค้าไอที? ทักหาทีมงานได้เลยตลอด 24 ชั่วโมง</p>
			<a class="post-cta-btn" href="https://line.me/R/ti/p/@webuy" target="_blank" rel="noopener noreferrer">แอดไลน์ @webuy รับประเมินราคาฟรี →</a>
		</aside>

		{relatedPosts.length > 0 && (
			<section class="related" aria-labelledby="related-heading">
				<h2 id="related-heading" class="related-title">{isEditorial ? 'บทความที่เกี่ยวข้อง' : 'บริการที่เกี่ยวข้อง'}</h2>
				<div class="related-grid">
					{relatedPosts.map((rp) => (
						<a href={`/${rp.slug}/`} class="related-card">
							{isEditorial && (
								<p class="related-card-date">
									{new Date(rp.date).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' })}
								</p>
							)}
							<p class="related-card-title" set:html={rp.title.rendered} />
						</a>
					))}
				</div>
				{isEditorial && <a href="/blog/" class="related-all">ดูบทความทั้งหมด →</a>}
			</section>
		)}
	</main>
</BaseLayout>

<style>
	.article { padding-block: 2rem 4rem; max-width: 720px; margin-inline: auto; overflow-x: hidden; }
	.article-head { margin-bottom: 1.5rem; }
	.date { display: block; font-size: 0.9rem; color: var(--muted); margin-bottom: 0.5rem; }
	.title { margin: 0; font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; }
	.hero-img { width: 100%; height: auto; border-radius: var(--radius); margin-bottom: 2rem; }
	.content { font-size: 1.05rem; }
	.content :global(.seo-intro-links) { font-size: 0.95rem; color: var(--muted); }
	.content :global(.seo-intro-cta) { margin-block: 1.25rem; }
	.content :global(.trust-bridge) { margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid rgba(36, 48, 67, 0.08); font-size: 0.95rem; color: var(--muted); }
	.content :global(a) { word-break: break-word; }
	.content :global(img) { max-width: 100% !important; height: auto !important; display: block; margin-block: 1rem; box-sizing: border-box; }
	.content :global(img[style*='width']) { width: auto !important; max-width: 100% !important; }
	.content :global(figure) { max-width: 100% !important; width: auto !important; margin: 1rem 0; box-sizing: border-box; }
	.content :global(figure img) { margin-block: 0; }
	.content :global(.wp-block-image), .content :global(.wp-caption), .content :global(.alignnone), .content :global(.aligncenter), .content :global(.alignwide), .content :global(.alignfull) { max-width: 100% !important; width: auto !important; box-sizing: border-box; }
	.content :global(iframe) { max-width: 100%; border: 0; }
	.content :global(video) { max-width: 100%; height: auto; }
	.post-cta { margin-top: 2.5rem; padding: 1.25rem 1.5rem; background: linear-gradient(105deg, #0b3d5c 0%, #0a6b5c 100%); border-radius: var(--radius); display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.5rem; }
	.post-cta-text { margin: 0; color: #e8f5f3; font-size: 0.97rem; flex: 1 1 200px; }
	.post-cta-btn { display: inline-block; padding: 0.55rem 1.1rem; background: #0a8a46; color: #fff; border-radius: 999px; font-weight: 700; font-size: 0.9rem; text-decoration: none; white-space: nowrap; }
	.related { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(36, 48, 67, 0.1); }
	.related-title { margin: 0 0 1rem; font-size: 1.1rem; }
	.related-grid { display: grid; gap: 0.65rem; }
	@media (min-width: 600px) { .related-grid { grid-template-columns: repeat(3, 1fr); } }
	.related-card { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.85rem 1rem; background: var(--surface); border: 1px solid rgba(36, 48, 67, 0.1); border-radius: var(--radius); text-decoration: none; }
	.related-card-date { margin: 0; font-size: 0.78rem; color: var(--muted); }
	.related-card-title { margin: 0; font-size: 0.9rem; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
	.related-all { display: inline-block; margin-top: 1rem; font-size: 0.9rem; font-weight: 600; color: var(--accent); }
</style>
