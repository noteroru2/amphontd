    "audit:p2-template-schema": "node scripts/qa-p2-template-schema.mjs",
    "qa:p0": "npm run audit:p0-index-surface && npm run build",
    "qa:p1": "npm run audit:p0-index-surface && npm run audit:p1-ownership && npm run build",
    "qa:p2": "npm run audit:p0-index-surface && npm run audit:p1-ownership && npm run audit:p2-template-schema && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-sans-thai": "^5.2.8",
